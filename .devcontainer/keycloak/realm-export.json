{
  "realm": "demo",
  "enabled": true,
  "sslRequired": "none",
  "roles": {
    "realm": [
      { "name": "user", "description": "Usuário padrão da aplicação" },
      { "name": "admin", "description": "Usuário administrador da aplicação"}
    ]
  },
  "users": [
    {
      "username": "appuser",
      "enabled": true,
      "emailVerified": true,
      "email": "appuser@example.com",
      "firstName": "Normal",
      "lastName": "User",
      "credentials": [
        { "type": "password", "value": "pass123", "temporary": false }
      ],
      "realmRoles": ["user"]
    },
    {
      "username": "appadmin",
      "enabled": true,
      "emailVerified": true,
      "email": "appadmin@example.com",
      "firstName": "Admin",
      "lastName": "User",
      "credentials": [
        { "type": "password", "value": "pass123", "temporary": false }
      ],
      "realmRoles": ["admin"]
    }
  ],
  "clients": [
    {
      "clientId": "spring",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "spring-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["*"],
      "webOrigins": ["*"]
    },
    {
      "clientId": "frontend",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["http://localhost:5173/*"],
      "webOrigins": ["http://localhost:5173"]
    }
  ]
}